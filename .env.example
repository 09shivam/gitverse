# GitVerse ingest secrets — copy to .env and fill in, then run `npm run ingest`.
# .env is gitignored; never commit real tokens.

# GitHub personal access token (no scopes needed for public data).
# Create at https://github.com/settings/tokens
# Raises rate limits + unlocks SBOM / contributor / activity endpoints (BFS).
GITHUB_TOKEN=

# Anthropic API key — activates the Claude classifier.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Classifier selector:
#   auto   = Claude if keyed, otherwise local model if GV_LOCAL_URL is set
#   claude = force Anthropic
#   local  = force GV_LOCAL_URL-compatible model
#   none   = heuristic fallback only
GV_CLASSIFIER=claude

# --- local/hosted model classifier (Qwen etc.) ---
# Any OpenAI-compatible endpoint. Setting GV_LOCAL_URL ACTIVATES it and takes
# precedence over Claude.
#
# Hosted (no install) — Hugging Face inference router; needs a free HF token:
#   https://huggingface.co/settings/tokens
# GV_LOCAL_URL=https://router.huggingface.co/v1
# GV_LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct
# GV_LOCAL_KEY=hf_xxx
#
# Fully offline — run the weights yourself via ingest/serve_qwen.py (see README):
# GV_LOCAL_URL=http://localhost:8080/v1
# GV_LOCAL_MODEL=qwen2.5-3b
# GV_LOCAL_BATCH=10

# --- optional tuning ---
# GV_MODEL=claude-opus-4-6
# GV_AI_BATCH=25
# GV_SEARCH=1
# GV_SEARCH_BUDGET=180
# GV_SEARCH_PER_QUERY=8
# GV_SEARCH_NEW_DAYS=365
# GV_SEARCH_ACTIVE_DAYS=90
# GV_DEPTH=1
# GV_BUDGET=240
